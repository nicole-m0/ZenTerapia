{
  "name": "terapia-zen",
  "version": "0.1.0",
  "private": true,
  "description": "Terapia Zen — site demonstrativo bilíngue (PT/EN) de terapias integrativas. Marca e conteúdo fictícios.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:qa": "astro build --mode qa",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:install": "playwright install chromium",
    "validate": "npm run check && npm run lint && npm run format:check && npm run build:qa && npm run test"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
