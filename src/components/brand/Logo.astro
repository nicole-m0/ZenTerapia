---
import LogoMark from './LogoMark.astro';
import { site } from '@/data/site';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const [first, ...rest] = site.name.split(' ');
---

<span class:list={['logo', className]}>
  <LogoMark />
  <span class="logo__wordmark">
    {first} <em>{rest.join(' ')}</em>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--fg);
  }

  .logo__wordmark {
    font-family: var(--font-display);
    font-size: 1.625rem;
    line-height: 1;
    letter-spacing: -0.01em;
    white-space: nowrap;
    /* compensa a altura das ascendentes para alinhar opticamente ao símbolo */
    padding-top: 0.08em;
  }

  .logo__wordmark em {
    font-style: italic;
  }
</style>
