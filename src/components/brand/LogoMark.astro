---
/**
 * Símbolo da marca: um anel aberto e um ponto na pausa.
 * O anel é a respiração; a abertura com o ponto é o instante entre inspirar e expirar.
 * Mesma geometria do favicon (public/favicon.svg).
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 28, class: className } = Astro.props;
---

<svg
  class:list={['logo-mark', className]}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M25.53 10.5A11 11 0 1 1 21.5 6.47"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linecap="round"
  ></path>
  <circle cx="23.78" cy="8.22" r="1.9" fill="var(--accent)"></circle>
</svg>

<style>
  .logo-mark {
    flex-shrink: 0;
  }
</style>
