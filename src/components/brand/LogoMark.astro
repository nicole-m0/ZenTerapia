---
/**
 * Símbolo da marca: uma janela de quatro vidraças vista de frente.
 * O caixilho divide a janela nas mesmas proporções usadas no site (40/60 na
 * vertical, 27/73 na horizontal); a vidraça de cima, à direita, é a que recebe luz.
 * Mesma geometria do favicon (public/favicon.svg).
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 28, class: className } = Astro.props;
---

<svg
  class:list={['logo-mark', className]}
  width={size * 0.8}
  height={size}
  viewBox="0 0 24 30"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <rect x="11.6" y="2.2" width="10.2" height="5.8" fill="var(--accent)"></rect>
  <path
    d="M1.2 1.2h21.6v27.6H1.2zM10.1 1.2v27.6M1.2 8.6h21.6"
    stroke="currentColor"
    stroke-width="2.2"
    stroke-linejoin="miter"
  ></path>
</svg>

<style>
  .logo-mark {
    flex-shrink: 0;
  }
</style>
