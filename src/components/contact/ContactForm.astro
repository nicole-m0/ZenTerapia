---
/**
 * Formulário de contato demonstrativo: valida no navegador e mostra a
 * confirmação, mas não envia nem guarda nada (não há back-end).
 *
 * Sem JavaScript o botão fica desativado (o que também bloqueia o envio pelo
 * Enter) e um aviso aponta para WhatsApp e e-mail, para que ninguém pense ter
 * enviado uma mensagem que não saiu.
 * Os erros são escritos no elemento ligado a cada campo por
 * aria-describedby e só existem enquanto o campo está inválido.
 */
import Button from '@/components/ui/Button.astro';
import DemoNote from '@/components/ui/DemoNote.astro';
import type { Locale } from '@/i18n/config';
import { getLocalizedPath, useTranslations } from '@/i18n/utils';
import type { getContactPageContent, getServices } from '@/lib/content';

interface Props {
  locale: Locale;
  content: Awaited<ReturnType<typeof getContactPageContent>>['form'];
  services: Awaited<ReturnType<typeof getServices>>;
}

const { locale, content, services } = Astro.props;
const practiceParam = locale === 'pt' ? 'pratica' : 'practice';
---

<div class="contact-form" data-contact-form data-reveal style="--reveal: 1">
  <form class="contact-form__form" novalidate data-practice-param={practiceParam}>
    <div class="contact-form__head">
      <h2 class="contact-form__title">{content.title}</h2>
      <p class="contact-form__intro">{content.intro}</p>
    </div>

    <div class="field field--half">
      <label for="cf-name">
        {content.name.label} <span class="field__req">({content.required})</span>
      </label>
      <input
        id="cf-name"
        name="name"
        type="text"
        autocomplete="name"
        required
        aria-describedby="cf-name-error"
        data-error={content.name.error}
      />
      <p id="cf-name-error" class="field__error"></p>
    </div>

    <div class="field field--half">
      <label for="cf-email">
        {content.email.label} <span class="field__req">({content.required})</span>
      </label>
      <input
        id="cf-email"
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        required
        aria-describedby="cf-email-error"
        data-error={content.email.error}
      />
      <p id="cf-email-error" class="field__error"></p>
    </div>

    <div class="field">
      <label for="cf-phone">{content.phone.label}</label>
      <input
        id="cf-phone"
        name="phone"
        type="tel"
        autocomplete="tel"
        aria-describedby="cf-phone-hint"
      />
      <p id="cf-phone-hint" class="field__hint">
        {content.phone.hint}
      </p>
    </div>

    <div class="field">
      <label for="cf-practice">{content.practice.label}</label>
      <div class="field__select">
        <select id="cf-practice" name="practice">
          <option value="">{content.practice.undecided}</option>
          {services.map((service) => (
            <option value={service.anchor}>{service.title}</option>
          ))}
        </select>
      </div>
    </div>

    <fieldset class="field field--choices">
      <legend>{content.modality.legend}</legend>
      <div class="choices">
        {content.modality.options.map((option, index) => (
          <label class="choice">
            <input type="radio" name="modality" value={option} checked={index === 2} />
            <span>{option}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <div class="field">
      <label for="cf-message">
        {content.message.label} <span class="field__req">({content.required})</span>
      </label>
      <textarea
        id="cf-message"
        name="message"
        rows="5"
        required
        minlength="10"
        aria-describedby="cf-message-hint cf-message-error"
        data-error={content.message.error}
      ></textarea>
      <p id="cf-message-hint" class="field__hint">
        {content.message.hint}
      </p>
      <p id="cf-message-error" class="field__error"></p>
    </div>

    <div class="field field--consent">
      <div class="consent">
        <input
          id="cf-consent"
          name="consent"
          type="checkbox"
          required
          aria-describedby="cf-consent-error"
          data-error={content.consent.error}
        />
        <label for="cf-consent">
          {content.consent.before}{' '}
          <a
            href={`${getLocalizedPath('legal', locale)}#${useTranslations(locale).anchors.privacy}`}
          >
            {content.consent.link}
          </a>
          .
        </label>
      </div>
      <p id="cf-consent-error" class="field__error"></p>
    </div>

    <p class="contact-form__summary" role="alert" data-summary data-text={content.errorSummary}></p>

    <div class="contact-form__submit">
      <Button type="submit" arrow disabled>
        {content.submit}
      </Button>
      <DemoNote>{content.demoNote}</DemoNote>
    </div>
    <noscript>
      <p class="contact-form__noscript">{content.noscript}</p>
    </noscript>
  </form>

  <div class="contact-form__success" hidden tabindex="-1" data-success>
    <span class="contact-form__mark" aria-hidden="true"></span>
    <h2 class="contact-form__title">{content.success.title}</h2>
    <p>{content.success.text}</p>
    <Button type="button" variant="secondary" class="contact-form__again">
      {content.success.again}
    </Button>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-contact-form]');
  const form = root?.querySelector<HTMLFormElement>('form');
  const success = root?.querySelector<HTMLElement>('[data-success]');
  const summary = root?.querySelector<HTMLElement>('[data-summary]');

  if (root && form && success && summary) {
    form.querySelector<HTMLButtonElement>('button[type="submit"]')?.removeAttribute('disabled');

    // ?pratica=reiki (ou ?practice=reiki) já chega com a prática escolhida
    const param = form.dataset.practiceParam ?? '';
    const preset = new URL(location.href).searchParams.get(param);
    const select = form.querySelector<HTMLSelectElement>('select[name="practice"]');
    if (preset && select?.querySelector(`option[value="${CSS.escape(preset)}"]`)) {
      select.value = preset;
    }

    const validated = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-error]');

    const isValid = (field: HTMLInputElement | HTMLTextAreaElement) => {
      if (field instanceof HTMLInputElement && field.type === 'checkbox') return field.checked;
      const value = field.value.trim();
      if (field.required && !value) return false;
      if (field.minLength > 0 && value.length < field.minLength) return false;
      return field.validity.valid;
    };

    const check = (field: HTMLInputElement | HTMLTextAreaElement) => {
      const valid = isValid(field);
      const error = document.getElementById(`${field.id}-error`);
      if (valid) field.removeAttribute('aria-invalid');
      else field.setAttribute('aria-invalid', 'true');
      if (error) error.textContent = valid ? '' : (field.dataset.error ?? '');
      return valid;
    };

    // depois do primeiro erro, o aviso some assim que o campo fica certo
    validated.forEach((field) => {
      const event =
        field instanceof HTMLInputElement && field.type === 'checkbox' ? 'change' : 'input';
      field.addEventListener(event, () => {
        if (field.hasAttribute('aria-invalid')) check(field);
      });
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const invalid = [...validated].filter((field) => !check(field));

      if (invalid.length > 0) {
        summary.textContent = summary.dataset.text ?? '';
        invalid[0]?.focus();
        return;
      }

      // demonstração: nada é enviado; só mostra a confirmação
      summary.textContent = '';
      form.hidden = true;
      success.hidden = false;
      success.focus();
    });

    success.querySelector('button')?.addEventListener('click', () => {
      form.reset();
      success.hidden = true;
      form.hidden = false;
      form.querySelector<HTMLInputElement>('input')?.focus();
    });
  }
</script>

<style>
  .contact-form {
    position: relative;
    background-color: var(--color-light);
    box-shadow: var(--shadow-wall);
  }

  /* verga: a travessa escura no alto do painel, como o topo de uma janela */
  .contact-form::before {
    content: '';
    display: block;
    height: var(--bar);
    background-color: var(--color-frame);
  }

  .contact-form__form,
  .contact-form__success {
    display: grid;
    gap: var(--space-m);
    padding: var(--space-l) var(--space-m) var(--space-xl);
  }

  .contact-form__form[hidden],
  .contact-form__success[hidden] {
    display: none;
  }

  .contact-form__head {
    display: grid;
    gap: var(--space-2xs);
  }

  .contact-form__title {
    font-size: var(--step-3);
    line-height: 1;
  }

  .contact-form__intro {
    font-size: var(--step--1);
    color: var(--color-stone);
  }

  /* ---------- Campos ---------- */

  .field {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .field label,
  .field legend {
    padding: 0;
    font-size: var(--step--1);
    font-weight: 500;
  }

  .field__req {
    font-weight: 400;
    color: var(--color-stone);
  }

  .field input:not([type='radio'], [type='checkbox']),
  .field textarea,
  .field select {
    width: 100%;
    min-height: 3rem;
    padding: 0.7rem 0.85rem;
    font: inherit;
    color: var(--color-ink);
    background-color: #fff;
    border: 1px solid var(--color-field);
    border-radius: 0;
    transition:
      border-color var(--duration-fast) ease,
      box-shadow var(--duration-fast) ease;
  }

  .field textarea {
    resize: vertical;
  }

  .field input:focus-visible,
  .field textarea:focus-visible,
  .field select:focus-visible {
    outline: 2px solid var(--color-frame);
    outline-offset: 2px;
    border-color: var(--color-frame);
  }

  .field [aria-invalid='true'] {
    border-color: var(--color-clay);
    box-shadow: inset 3px 0 0 var(--color-clay);
  }

  .field__select {
    position: relative;
  }

  .field__select select {
    appearance: none;
    padding-inline-end: 2.5rem;
  }

  /* seta: um pequeno ângulo de caixilho */
  .field__select::after {
    content: '';
    position: absolute;
    top: 50%;
    right: 1rem;
    width: 0.5rem;
    height: 0.5rem;
    border-right: 2px solid var(--color-frame);
    border-bottom: 2px solid var(--color-frame);
    translate: 0 -70%;
    rotate: 45deg;
    pointer-events: none;
  }

  .field__hint {
    font-size: var(--step--2);
    color: var(--color-stone);
  }

  .field__error {
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--color-clay);
  }

  .field__error:empty,
  .contact-form__summary:empty {
    display: none;
  }

  /* erros e confirmação chegam com a mesma subida curta das entradas */
  @media (prefers-reduced-motion: no-preference) {
    .field__error:not(:empty),
    .contact-form__summary:not(:empty) {
      animation: enter-up var(--duration-base) var(--ease-out) both;
    }

    .contact-form__success:not([hidden]) {
      animation: enter-up var(--duration-slow) var(--ease-out) both;
    }
  }

  /* ---------- Escolhas ---------- */

  .field--choices legend {
    margin-bottom: 0.4rem;
  }

  .choices {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .field .choice {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.9rem;
    font-weight: 400;
    border: 1px solid var(--color-field);
    cursor: pointer;
  }

  .choice:has(input:checked) {
    background-color: var(--color-dim);
    border-color: var(--color-frame);
  }

  .choice input,
  .consent input {
    width: 1.125rem;
    height: 1.125rem;
    margin: 0;
    accent-color: var(--color-frame);
  }

  .choice:has(input:focus-visible) {
    outline: 2px solid var(--color-frame);
    outline-offset: 2px;
  }

  .consent {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 0.75rem;
  }

  .consent input {
    margin-top: 0.2rem;
  }

  .consent label {
    font-weight: 400;
    line-height: 1.5;
  }

  .consent a {
    color: var(--color-ink);
    text-underline-offset: 0.2em;
  }

  /* ---------- Envio ---------- */

  .contact-form__summary {
    padding: 0.75rem 1rem;
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--color-ink);
    border-inline-start: 3px solid var(--color-clay);
    background-color: var(--color-paper);
  }

  .contact-form__submit {
    display: grid;
    justify-items: start;
    gap: var(--space-s);
    margin-top: var(--space-2xs);
  }

  /* sem JS o envio fica desativado e o aviso de alternativa aparece */
  .contact-form__submit :global(.button:disabled) {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .contact-form__noscript {
    font-size: var(--step--1);
    color: var(--color-ink);
  }

  /* ---------- Confirmação ---------- */

  .contact-form__success {
    justify-items: start;
    align-content: start;
    min-height: 24rem;
  }

  .contact-form__success:focus {
    outline: none;
  }

  .contact-form__success p {
    max-width: 40ch;
    color: var(--color-stone);
  }

  /* uma vidraça acesa */
  .contact-form__mark {
    width: 2.25rem;
    height: 2.75rem;
    background:
      linear-gradient(var(--color-frame), var(--color-frame)) 40% 0 / 3px 100% no-repeat,
      linear-gradient(var(--color-frame), var(--color-frame)) 0 27% / 100% 3px no-repeat,
      var(--color-light);
    border: 4px solid var(--color-frame);
  }

  @media (min-width: 40rem) {
    .contact-form__form,
    .contact-form__success {
      padding: var(--space-xl) var(--space-l) var(--space-2xl);
    }

    .contact-form__form {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-m);
    }

    .contact-form__form > :not(.field--half) {
      grid-column: 1 / -1;
    }
  }
</style>
