---
/**
 * Capa: a janela à direita e a luz que ela projeta na parede, à esquerda,
 * por trás do título. A projeção usa as mesmas proporções do caixilho.
 */
import Button from '@/components/ui/Button.astro';
import Emphasis from '@/components/ui/Emphasis.astro';
import TextLink from '@/components/ui/TextLink.astro';
import LightCast from '@/components/window/LightCast.astro';
import Window from '@/components/window/Window.astro';
import { images } from '@/data/images';
import type { Locale } from '@/i18n/config';
import { getLocalizedPath, useTranslations } from '@/i18n/utils';
import type { getHomeContent } from '@/lib/content';

interface Props {
  locale: Locale;
  content: Awaited<ReturnType<typeof getHomeContent>>['hero'];
}

const { locale, content } = Astro.props;
const t = useTranslations(locale);
const lines = content.title.split('|');
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <figure class="hero__figure">
      <Window
        class="hero__window"
        photo={images.heroJanela}
        locale={locale}
        widths={[480, 720, 960, 1280, 1600]}
        sizes="(min-width: 60rem) 52vw, 100vw"
        eager
        sill
      />
      <figcaption class="hero__caption">{content.caption}</figcaption>
    </figure>

    <LightCast class="hero__light" motion="load" />

    <div class="hero__text">
      <p class="eyebrow">{content.eyebrow}</p>
      <h1 id="hero-title" class="hero__title">
        {lines.map((line, index) => (
          <span class="hero__line" style={`--line: ${index}`}>
            <Emphasis text={line} />{' '}
          </span>
        ))}
      </h1>
      <p class="lead hero__lead">{content.lead}</p>
      <div class="hero__actions">
        <Button href={getLocalizedPath('contact', locale)} arrow>
          {t.nav.book}
        </Button>
        <TextLink href={getLocalizedPath('services', locale)}>
          {content.secondaryCta.label}
        </TextLink>
      </div>
    </div>

    <ul class="hero__facts" role="list">
      {content.facts.map((fact) => (
        <li>{fact}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero {
    overflow: clip;
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-bottom: var(--space-2xl);
  }

  /* ---------- Janela ---------- */

  /* Celular: a janela ocupa a largura toda da tela, como se estivéssemos diante dela */
  .hero__figure {
    position: relative;
    z-index: 1;
    margin-inline: calc(var(--gutter) * -1);
  }

  .hero__figure :global(.hero__window) {
    height: clamp(25rem, 112vw, 34rem);
  }

  .hero__caption {
    position: absolute;
    top: calc(100% + var(--bar) * 1.5 + 0.75rem);
    right: var(--gutter);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  /* ---------- Luz projetada ---------- */

  /*
   * Luz de janela de verdade: montantes projetados mais largos, bordas em
   * penumbra e intensidade que cai à medida que se afasta da janela.
   */
  .hero__inner :global(.hero__light) {
    position: absolute;
    z-index: 0;
    top: calc(clamp(25rem, 112vw, 34rem) + var(--space-xl));
    left: 14%;
    width: 64%;
    height: 18rem;
    gap: calc(var(--bar) * 2);
    filter: blur(clamp(2.5px, 0.1rem + 0.15vw, 4.5px));
    mask-image: linear-gradient(to bottom left, #000 45%, rgb(0 0 0 / 0.6) 75%, rgb(0 0 0 / 0.15));
  }

  /* ---------- Texto ---------- */

  .hero__text {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: start;
    gap: var(--space-l);
    padding-top: var(--space-2xl);
  }

  .hero__text .eyebrow {
    margin-bottom: calc(var(--space-s) - var(--space-l));
  }

  /* um pouco mais de entrelinha que os outros títulos: a cedilha não toca a linha seguinte */
  .hero__title {
    font-size: var(--step-hero);
    line-height: 1;
  }

  .hero__line {
    display: block;
  }

  /* a segunda linha entra recuada, como um degrau de luz */
  .hero__line:nth-child(2) {
    padding-inline-start: 0.5em;
  }

  .hero__lead {
    max-width: 34ch;
  }

  .hero__actions {
    display: grid;
    justify-items: start;
    gap: var(--space-m);
    width: 100%;
  }

  .hero__actions :global(.button) {
    width: 100%;
  }

  .hero__facts {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: var(--space-xl);
    font-size: var(--step--1);
    color: var(--fg-muted);
  }

  .hero__facts li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  /* marcador: uma vidraça em miniatura */
  .hero__facts li::before {
    content: '';
    width: 0.4375rem;
    height: 0.5625rem;
    border: 1.5px solid var(--color-frame);
  }

  /* ---------- Entrada ---------- */

  @media (prefers-reduced-motion: no-preference) {
    .hero__line {
      animation: line-in 1.1s var(--ease-out) both;
      animation-delay: calc(200ms + var(--line) * 110ms);
    }

    .hero__lead,
    .hero__actions,
    .hero__text .eyebrow {
      animation: line-in 1.1s var(--ease-out) 560ms both;
    }

    .hero__text .eyebrow {
      animation-delay: 120ms;
    }
  }

  @keyframes line-in {
    from {
      opacity: 0;
      translate: 0 0.35em;
    }
  }

  /* ---------- Tablet ---------- */

  @media (min-width: 40rem) {
    /* a janela recua para a direita e deixa a parede à mostra, onde a luz cai */
    .hero__figure {
      width: 78%;
      margin-inline: auto 0;
      margin-top: var(--space-m);
    }

    .hero__figure :global(.hero__window) {
      height: 34rem;
    }

    .hero__caption {
      right: 0;
    }

    .hero__inner :global(.hero__light) {
      top: 39rem;
      left: 10%;
      width: 50%;
      height: 20rem;
    }

    .hero__text {
      padding-top: var(--space-2xl);
    }

    .hero__actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-s) var(--space-l);
      width: auto;
    }

    .hero__actions :global(.button) {
      width: auto;
    }
  }

  /* ---------- Desktop ---------- */

  @media (min-width: 60rem) {
    .hero__inner {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--grid-gap);
      min-height: min(56rem, calc(100svh - var(--header-height)));
      padding-bottom: var(--space-3xl);
    }

    .hero__figure {
      grid-column: 7 / -1;
      grid-row: 1;
      width: auto;
      margin: var(--space-xs) 0 0;
    }

    .hero__figure :global(.hero__window) {
      height: clamp(34rem, calc(100svh - var(--header-height) - 6.5rem), 46rem);
    }

    /*
     * A luz nasce por baixo do caixilho (o canto superior entra sob a janela)
     * e se apaga na parede atrás do título: é a única sobreposição do Hero.
     */
    .hero__inner :global(.hero__light) {
      top: 24%;
      left: 12%;
      width: 44%;
      height: 50%;
    }

    /*
     * O texto ocupa as seis primeiras colunas e termina na linha do peitoril.
     * O título é medido pela largura da própria coluna (cqi), então mantém
     * folga até a janela em qualquer largura e idioma.
     */
    .hero__text {
      grid-column: 1 / span 6;
      grid-row: 1;
      align-self: end;
      margin-top: var(--space-xl);
      padding-right: var(--grid-gap);
      container-type: inline-size;
    }

    .hero__title {
      font-size: min(var(--step-hero), 19cqi);
    }

    .hero__facts {
      grid-column: 1 / span 6;
      grid-row: 2;
      margin-top: var(--space-xl);
    }
  }
</style>
