---
import { Picture } from 'astro:assets';
import DemoNote from '@/components/ui/DemoNote.astro';
import Emphasis from '@/components/ui/Emphasis.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import TextLink from '@/components/ui/TextLink.astro';
import { images } from '@/data/images';
import type { Locale } from '@/i18n/config';
import { getLocalizedPath } from '@/i18n/utils';
import type { getHomeContent } from '@/lib/content';

interface Props {
  locale: Locale;
  content: Awaited<ReturnType<typeof getHomeContent>>['intro'];
}

const { locale, content } = Astro.props;
const photo = images.cortina;
---

<section class="intro container" aria-labelledby="intro-title">
  <div class="intro__label">
    <SectionLabel number="01">{content.label}</SectionLabel>
  </div>
  <h2 id="intro-title" class="intro__statement">
    <Emphasis text={content.statement} />
  </h2>

  <div class="intro__media media-frame">
    <Picture
      src={photo.src}
      alt={photo.alt[locale]}
      widths={[400, 640, 900]}
      sizes="(min-width: 60rem) 28vw, 64vw"
      formats={['avif', 'webp']}
    />
  </div>

  <div class="intro__body">
    {content.body.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
    <DemoNote>{content.demoNote}</DemoNote>
    <TextLink href={getLocalizedPath('about', locale)} arrow>
      {content.link.label}
    </TextLink>
  </div>
</section>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-l);
    padding-block: var(--space-3xl) var(--space-section);
  }

  .intro__statement {
    font-size: clamp(1.875rem, 1.35rem + 2.25vw, 3.375rem);
    line-height: 1.08;
    max-width: 24ch;
  }

  .intro__media {
    width: 64%;
    aspect-ratio: 3 / 4;
    margin-top: var(--space-l);
  }

  .intro__body {
    display: grid;
    justify-items: start;
    gap: var(--space-s);
    color: var(--fg-muted);
  }

  .intro__body :global(.text-link) {
    margin-top: var(--space-xs);
  }

  @media (min-width: 60rem) {
    .intro {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--grid-gap);
      row-gap: var(--space-2xl);
    }

    .intro__label {
      grid-column: 1 / span 3;
      padding-top: 0.75rem;
    }

    .intro__statement {
      grid-column: 4 / -1;
    }

    .intro__media {
      grid-column: 2 / span 4;
      width: auto;
      margin-top: 0;
    }

    /* o texto desce até a base da foto: leitura em diagonal pela página */
    .intro__body {
      grid-column: 7 / span 5;
      align-self: end;
      max-width: 40ch;
    }
  }
</style>
