---
/**
 * Relatos escritos em vidraças de vidro jateado: uma janela de três folhas,
 * a maior para o relato principal. O aviso de conteúdo fictício fica visível
 * no cabeçalho e em cada relato.
 */
import DemoNote from '@/components/ui/DemoNote.astro';
import Emphasis from '@/components/ui/Emphasis.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import type { getHomeContent, getTestimonials } from '@/lib/content';

interface Props {
  content: Awaited<ReturnType<typeof getHomeContent>>['testimonials'];
  testimonials: Awaited<ReturnType<typeof getTestimonials>>;
}

const { content, testimonials } = Astro.props;
---

<section class="testimonials" aria-labelledby="testimonials-title">
  <div class="container">
    <header class="testimonials__head" data-reveal>
      <SectionLabel number="04">{content.label}</SectionLabel>
      <h2 id="testimonials-title">
        <Emphasis text={content.title} />
      </h2>
      <DemoNote>{content.disclaimer}</DemoNote>
    </header>

    <div class="testimonials__window" data-reveal style="--reveal: 1">
      {testimonials.map((item, index) => (
        <figure class:list={['quote', index === 0 ? 'quote--lead' : 'quote--minor']}>
          <blockquote>
            <p>{item.quote}</p>
          </blockquote>
          <figcaption>
            <span class="quote__name">{item.name}</span>
            <span class="quote__detail">{item.detail}</span>
            <span class="quote__demo">
              <DemoNote as="span">{content.itemNote}</DemoNote>
            </span>
          </figcaption>
        </figure>
      ))}
      <span class="testimonials__sill" aria-hidden="true"></span>
    </div>
  </div>
</section>

<style>
  .testimonials {
    padding-block: var(--space-section);
  }

  .testimonials__head {
    display: grid;
    justify-items: start;
    gap: var(--space-m);
    margin-bottom: var(--space-2xl);
  }

  .testimonials__head h2 {
    max-width: 12ch;
  }

  /* a janela: caixilho como fundo, as vidraças separadas pelo vão do montante */
  .testimonials__window {
    position: relative;
    display: grid;
    gap: var(--bar);
    padding: var(--bar);
    margin-bottom: calc(var(--bar) * 1.5);
    background-color: var(--color-frame);
  }

  .testimonials__sill {
    position: absolute;
    top: 100%;
    left: calc(var(--bar) * -1.75);
    right: calc(var(--bar) * -1.75);
    height: calc(var(--bar) * 1.5);
    background-color: var(--color-frame);
    box-shadow: var(--shadow-wall);
  }

  /* vidro jateado: mais claro onde a luz bate (alto, à direita) */
  .quote {
    position: relative;
    display: grid;
    align-content: space-between;
    gap: var(--space-l);
    padding: var(--space-l) var(--space-m) var(--space-m);
    background: linear-gradient(200deg, var(--color-light) 30%, #efede4);
    box-shadow: var(--shadow-reveal);
    transition: background-color var(--duration-slow) var(--ease-out);
  }

  .quote blockquote p {
    font-family: var(--font-display);
    letter-spacing: -0.005em;
    text-wrap: pretty;
  }

  .quote--lead blockquote p {
    font-size: var(--step-3);
    line-height: 1.12;
    max-width: 22ch;
  }

  /* aspas de abertura em argila, grandes, na quina da vidraça */
  .quote--lead blockquote p::before {
    content: '“';
    display: block;
    height: 0.5em;
    font-size: 2.2em;
    line-height: 1;
    color: var(--accent);
  }

  .quote--minor blockquote p {
    font-size: var(--step-1);
    line-height: 1.35;
    max-width: 34ch;
  }

  .quote figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    font-size: var(--step--1);
  }

  .quote__name {
    font-weight: 500;
  }

  .quote__detail {
    color: var(--fg-muted);
  }

  .quote__detail::before {
    content: '';
    display: inline-block;
    width: 1.25rem;
    height: 1px;
    margin-right: 0.75rem;
    vertical-align: middle;
    background-color: currentColor;
  }

  .quote__demo {
    flex-basis: 100%;
    margin-top: 0.25rem;
  }

  @media (min-width: 40rem) {
    .quote {
      padding: var(--space-xl) var(--space-l) var(--space-l);
    }
  }

  @media (min-width: 60rem) {
    .testimonials__head {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--grid-gap);
      align-items: end;
    }

    .testimonials__head :global(.section-label) {
      grid-column: 1 / -1;
    }

    .testimonials__head h2 {
      grid-column: 1 / span 7;
    }

    .testimonials__head :global(.demo-note) {
      grid-column: 9 / span 4;
    }

    /* janela de três folhas: a principal ocupa a altura toda */
    .testimonials__window {
      grid-template-columns: 7fr 5fr;
      grid-template-rows: auto auto;
    }

    .quote--lead {
      grid-row: span 2;
      padding: var(--space-2xl) var(--space-2xl) var(--space-xl);
    }

    .quote--minor {
      padding: var(--space-xl) var(--space-xl) var(--space-l);
    }
  }
</style>
