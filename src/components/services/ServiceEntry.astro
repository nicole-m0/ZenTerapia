---
/**
 * Ficha de uma prática. Cada prática tem a própria janela (as proporções das
 * vidraças mudam de uma para outra), que fica parada enquanto o texto rola
 * ao lado (desktop). Os dados práticos ficam no "peitoril": uma faixa escura
 * dividida por montantes, logo abaixo do resumo.
 */
import Button from '@/components/ui/Button.astro';
import Window from '@/components/window/Window.astro';
import { getPhoto } from '@/data/images';
import { localeMeta, type Locale } from '@/i18n/config';
import { getLocalizedPath } from '@/i18n/utils';
import type { getServices, getServicesPageContent } from '@/lib/content';

interface Props {
  locale: Locale;
  service: Awaited<ReturnType<typeof getServices>>[number];
  labels: Awaited<ReturnType<typeof getServicesPageContent>>['labels'];
  index: number;
  total: number;
}

const { locale, service, labels, index, total } = Astro.props;
const photo = getPhoto(service.image);

/** Uma janela diferente por prática, todas da mesma família. */
const frames = [
  { cols: [40, 60], rows: [27, 73] },
  { cols: [1], rows: [32, 68] },
  { cols: [1, 1], rows: [1] },
  { cols: [60, 40], rows: [73, 27] },
];
const frame = frames[index % frames.length] ?? { cols: [40, 60], rows: [27, 73] };

const price = new Intl.NumberFormat(localeMeta[locale].htmlLang, {
  style: 'currency',
  currency: 'BRL',
  maximumFractionDigits: 0,
}).format(service.price);

const pad = (value: number) => String(value).padStart(2, '0');
const bookParam = locale === 'pt' ? 'pratica' : 'practice';
const bookHref = `${getLocalizedPath('contact', locale)}?${bookParam}=${service.anchor}`;
const titleId = `${service.anchor}-title`;
---

<article id={service.anchor} class="entry" aria-labelledby={titleId}>
  <div class="entry__media">
    <Window
      class="entry__window"
      photo={photo}
      locale={locale}
      cols={frame.cols}
      rows={frame.rows}
      widths={[480, 720, 960, 1280]}
      sizes="(min-width: 60rem) 38vw, 100vw"
      sill
    />
  </div>

  <div class="entry__body" data-reveal>
    <p class="entry__count" aria-hidden="true">
      {pad(index + 1)}
      <span> / {pad(total)}</span>
    </p>
    <h2 id={titleId} class="entry__title">
      {service.title}
    </h2>
    <p class="lead entry__summary">{service.summary}</p>

    <dl class="entry__sill surface-dark">
      <div>
        <dt>{labels.duration}</dt>
        <dd>
          {service.durationMinutes} {labels.minutes}
        </dd>
      </div>
      <div>
        <dt>{labels.format}</dt>
        <dd>{service.format}</dd>
      </div>
      <div>
        <dt>{labels.price}</dt>
        <dd>{price}</dd>
      </div>
    </dl>

    <div class="entry__details">
      <section class="entry__block" aria-labelledby={`${service.anchor}-for`}>
        <h3 id={`${service.anchor}-for`} class="entry__heading">
          {labels.forWhom}
        </h3>
        <p>{service.forWhom}</p>
      </section>
      <section class="entry__block" aria-labelledby={`${service.anchor}-session`}>
        <h3 id={`${service.anchor}-session`} class="entry__heading">
          {labels.session}
        </h3>
        <ol class="entry__steps" role="list">
          {service.steps.map((step) => (
            <li>{step}</li>
          ))}
        </ol>
      </section>
    </div>

    <aside class="entry__note" aria-labelledby={`${service.anchor}-note`}>
      <h3 id={`${service.anchor}-note`} class="entry__heading">
        {labels.note}
      </h3>
      <p>{service.note}</p>
    </aside>

    <Button href={bookHref} arrow>
      {labels.book}
    </Button>
  </div>
</article>

<style>
  .entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl);
    scroll-margin-top: calc(var(--header-height) + var(--space-m));
  }

  /* celular: a janela ocupa a largura toda, mais baixa que larga */
  .entry__media {
    margin-inline: calc(var(--gutter) * -1);
  }

  .entry__media :global(.entry__window) {
    height: clamp(17rem, 72vw, 26rem);
  }

  .entry__body {
    display: grid;
    justify-items: start;
    gap: var(--space-m);
  }

  .entry__count {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-style: italic;
    line-height: 1;
    color: var(--accent);
  }

  .entry__count span {
    color: var(--fg-muted);
  }

  .entry__title {
    font-size: var(--step-5);
    line-height: 0.96;
    text-wrap: balance;
  }

  .entry__summary {
    max-width: 36ch;
  }

  /* ---------- Peitoril: duração, formato e valor ---------- */

  .entry__sill {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--bar);
    width: 100%;
    margin: var(--space-2xs) 0 0;
    padding: var(--bar);
    box-shadow: var(--shadow-wall);
  }

  .entry__sill div {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    padding: var(--space-xs) var(--space-s);
    background-color: color-mix(in srgb, var(--color-light) 6%, var(--bg));
  }

  .entry__sill dt {
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .entry__sill dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.1;
  }

  /* ---------- Detalhes ---------- */

  .entry__details {
    display: grid;
    gap: var(--space-l);
    width: 100%;
    margin-top: var(--space-s);
  }

  .entry__block {
    display: grid;
    align-content: start;
    gap: var(--space-xs);
    padding-top: var(--space-s);
    border-top: var(--border-hairline);
  }

  .entry__heading {
    font-family: var(--font-body);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .entry__steps {
    display: grid;
    gap: var(--space-xs);
    counter-reset: step;
  }

  .entry__steps li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    counter-increment: step;
  }

  .entry__steps li::before {
    content: counter(step, lower-roman) '.';
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-1);
    line-height: 1.3;
    color: var(--accent);
  }

  /*
   * "Bom saber": escrito dentro de uma mancha de luz. O fundo inclina no
   * ângulo comum do site; o texto continua reto.
   */
  .entry__note {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: var(--space-2xs);
    max-width: 44ch;
    margin-block: var(--space-xs);
    padding: var(--space-s) var(--space-l) var(--space-s) calc(var(--space-l) + 0.5rem);
  }

  .entry__note::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--color-light);
    transform: skewX(var(--light-skew));
    filter: blur(0.6px);
  }

  .entry__note p {
    color: var(--color-stone);
  }

  @media (min-width: 40rem) {
    .entry__media {
      margin-inline: 0;
    }

    .entry__details {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ---------- Desktop: a janela fica parada enquanto a ficha rola ---------- */

  @media (min-width: 60rem) {
    .entry {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--grid-gap);
    }

    .entry__media {
      grid-column: 1 / span 5;
      align-self: start;
      position: sticky;
      top: calc(var(--header-height) + var(--space-l));
    }

    .entry__media :global(.entry__window) {
      height: min(38rem, calc(100svh - var(--header-height) - var(--space-3xl)));
    }

    .entry__body {
      grid-column: 7 / -1;
      padding-block: var(--space-m) var(--space-xl);
    }
  }
</style>
