---
/**
 * Botão em vidraças: com `arrow`, o rótulo e a seta ocupam duas vidraças
 * separadas por um montante na cor da parede. No hover, uma faixa de luz
 * atravessa o vidro no mesmo ângulo da luz projetada no resto do site.
 */
import Icon from './Icon.astro';

interface Props {
  /** Com `href` vira link; sem, vira `<button>`. */
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: 'primary' | 'secondary';
  size?: 'md' | 'sm';
  /** Seta numa segunda vidraça, que avança no hover. */
  arrow?: boolean;
  fullWidth?: boolean;
  class?: string;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  size = 'md',
  arrow = false,
  fullWidth = false,
  class: className,
} = Astro.props;

const classes = [
  'button',
  `button--${variant}`,
  `button--${size}`,
  { 'button--arrow': arrow, 'button--full': fullWidth },
  className,
];
---

{href ? (
  <a href={href} class:list={classes}>
    <span class="button__label">
      <slot />
    </span>
    {arrow && (
      <span class="button__pane" aria-hidden="true">
        <Icon name="arrow-right" size={18} class="button__arrow" />
      </span>
    )}
  </a>
) : (
  <button type={type} class:list={classes}>
    <span class="button__label">
      <slot />
    </span>
    {arrow && (
      <span class="button__pane" aria-hidden="true">
        <Icon name="arrow-right" size={18} class="button__arrow" />
      </span>
    )}
  </button>
)}

<style>
  .button {
    --button-bg: var(--color-frame);
    --button-bg-hover: var(--color-moss-hover);
    --button-fg: var(--color-light);
    --button-height: 3.25rem;

    position: relative;
    display: inline-flex;
    align-items: stretch;
    min-height: var(--button-height);
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
    color: var(--button-fg);
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
  }

  .button__label,
  .button__pane {
    position: relative;
    display: inline-flex;
    align-items: center;
    overflow: hidden;
    background-color: var(--button-bg);
    transition: background-color var(--duration-base) var(--ease-out);
  }

  .button__label {
    flex: 1;
    justify-content: center;
    padding: 0.75rem 1.5rem;
  }

  .button__pane {
    justify-content: center;
    width: var(--button-height);
    flex-shrink: 0;
    /* montante entre as vidraças: a parede aparece no vão */
    margin-inline-start: 2px;
  }

  /* faixa de luz que atravessa a vidraça do rótulo */
  .button__label::before {
    content: '';
    position: absolute;
    inset: -20% auto -20% 0;
    width: 45%;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in srgb, var(--color-light) 22%, transparent),
      transparent
    );
    transform: translateX(-130%) skewX(var(--light-skew));
    pointer-events: none;
  }

  .button:hover .button__label::before {
    transform: translateX(300%) skewX(var(--light-skew));
    transition: transform var(--duration-light) var(--ease-out);
  }

  .button:hover .button__label,
  .button:hover .button__pane {
    background-color: var(--button-bg-hover);
  }

  /* a seta sai pela direita da vidraça e volta pela esquerda */
  .button__pane :global(.button__arrow) {
    transition: transform var(--duration-base) var(--ease-out);
  }

  .button:hover .button__pane :global(.button__arrow) {
    animation: arrow-through 640ms var(--ease-out);
  }

  @keyframes arrow-through {
    45% {
      transform: translateX(140%);
    }

    46% {
      transform: translateX(-140%);
    }

    100% {
      transform: translateX(0);
    }
  }

  .button:focus-visible {
    outline-offset: 4px;
  }

  .button--sm {
    --button-height: 2.75rem;
  }

  .button--sm .button__label {
    padding: 0.5rem 1.125rem;
  }

  .button--full {
    display: flex;
    width: 100%;
  }

  .button--full .button__label {
    justify-content: flex-start;
  }

  .button--secondary {
    --button-bg: transparent;
    --button-bg-hover: color-mix(in srgb, var(--fg) 7%, transparent);
    --button-fg: var(--fg);
  }

  .button--secondary .button__label,
  .button--secondary .button__pane {
    box-shadow: inset 0 0 0 1.5px currentColor;
  }

  /* Em superfície escura o primário inverte: vidro iluminado com texto em tinta */
  :global(.surface-dark) .button--primary {
    --button-bg: var(--color-light);
    --button-bg-hover: var(--color-paper);
    --button-fg: var(--color-ink);
  }

  :global(.surface-dark) .button--primary .button__label::before {
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in srgb, #fff 70%, transparent),
      transparent
    );
  }
</style>
