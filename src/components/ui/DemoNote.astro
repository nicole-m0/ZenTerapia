---
/**
 * Marca visual de conteúdo demonstrativo (persona, relatos, formação, valores).
 * Uma janela em miniatura, a mesma do símbolo, seguida de texto curto.
 * Sempre visível e legível: não é um rodapé escondido.
 */
interface Props {
  as?: 'p' | 'span';
}

const { as: Tag = 'p' } = Astro.props;
---

<Tag class="demo-note">
  <svg
    class="demo-note__mark"
    width="11"
    height="14"
    viewBox="0 0 24 30"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M1.6 1.6h20.8v26.8H1.6zM10.1 1.6v26.8M1.6 8.6h20.8"
      stroke="currentColor"
      stroke-width="3.2"
    ></path>
  </svg>
  <span>
    <slot />
  </span>
</Tag>

<style>
  .demo-note {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    max-width: none;
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--fg-muted);
  }

  .demo-note__mark {
    flex-shrink: 0;
    color: var(--accent);
  }
</style>
