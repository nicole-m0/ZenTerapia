---
import { Font } from 'astro:assets';
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import SeoHead from '@/components/layout/SeoHead.astro';
import { localeMeta, type Locale, type RouteKey } from '@/i18n/config';
import { useTranslations } from '@/i18n/utils';
import '@/styles/global.css';

interface Props {
  locale: Locale;
  route: RouteKey | null;
  title: string;
  description: string;
  noindex?: boolean;
}

const { locale, route, title, description, noindex = false } = Astro.props;
const t = useTranslations(locale);
---

<!doctype html>
<html lang={localeMeta[locale].htmlLang}>
  <head>
    <SeoHead
      locale={locale}
      route={route}
      title={title}
      description={description}
      noindex={noindex}
    />
    <Font cssVariable="--font-display-family" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-body-family" preload />
    {/*
      Revelação na rolagem, parte 1: marca o <html> antes da pintura para os
      blocos com data-reveal começarem escondidos. Se o observador (parte 2,
      no fim do body) não confirmar até o DOMContentLoaded, a marca sai e tudo
      aparece. Sem JS ou com movimento reduzido, nada é escondido.
    */}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        if (!('IntersectionObserver' in window)) return;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        root.classList.add('motion');
        addEventListener('DOMContentLoaded', () => {
          if (!window.__revealReady) root.classList.remove('motion');
        });
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t.a11y.skipToContent}
    </a>
    <Header locale={locale} route={route} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} route={route} />
    {/* Revelação na rolagem, parte 2: revela cada bloco uma vez, ao entrar na tela. */}
    <script is:inline>
      (() => {
        if (!document.documentElement.classList.contains('motion')) return;
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
        window.__revealReady = true;
      })();
    </script>
  </body>
</html>
