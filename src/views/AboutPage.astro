---
/**
 * Sobre: sem retrato. A terapeuta (fictícia) aparece pela sala onde atende:
 * uma janela estreita com a sombra do caixilho na parede, o nome escrito ao
 * lado, os princípios como vidraças de texto, a trajetória num fim de tarde
 * (faixa escura, com o montante da janela como linha do tempo) e a sala vista
 * por uma janela panorâmica.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ClosingCta from '@/components/home/ClosingCta.astro';
import DemoNote from '@/components/ui/DemoNote.astro';
import Emphasis from '@/components/ui/Emphasis.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import LightCast from '@/components/window/LightCast.astro';
import Window from '@/components/window/Window.astro';
import { images } from '@/data/images';
import type { Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/utils';
import { getAboutPageContent } from '@/lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const page = useTranslations(locale).pages.about;
const content = await getAboutPageContent(locale);
const [firstName, ...rest] = content.head.name.split(' ');
const numerals = ['i.', 'ii.', 'iii.'];
---

<BaseLayout locale={locale} route="about" title={page.title} description={page.description}>
  <header class="about-head">
    <div class="container about-head__inner">
      <figure class="about-head__figure">
        <Window
          class="about-head__window"
          photo={images.luzParede}
          locale={locale}
          cols={[1, 1]}
          rows={[24, 76]}
          widths={[400, 640, 900, 1200]}
          sizes="(min-width: 60rem) 30vw, (min-width: 40rem) 44vw, 64vw"
          eager
          sill
        />
        <figcaption class="about-head__caption">{content.head.caption}</figcaption>
      </figure>

      <div class="about-head__text">
        <p class="eyebrow enter">{content.head.eyebrow}</p>
        <h1 class="about-head__name">
          <span class="enter" style="--enter: 1">
            {firstName}
          </span>
          <span class="about-head__surname enter" style="--enter: 2">
            {rest.join(' ')}
          </span>
        </h1>
        <p class="about-head__role enter" style="--enter: 3">
          {content.head.role}
        </p>
        <div class="enter" style="--enter: 4">
          <DemoNote>{content.head.demoNote}</DemoNote>
        </div>
      </div>
    </div>
  </header>

  <section class="story" aria-labelledby="story-title">
    <div class="container story__inner">
      <h2 id="story-title" class="story__statement" data-reveal>
        <Emphasis text={content.head.statement} />
      </h2>
      <div class="story__body">
        <LightCast class="story__light" cols={[1, 1]} rows={[24, 76]} soft />
        {content.head.body.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </div>
  </section>

  <section class="principles" aria-labelledby="principles-title">
    <div class="container">
      <div class="principles__head" data-reveal>
        <SectionLabel number="01">{content.principles.label}</SectionLabel>
        <h2 id="principles-title" class="principles__title">
          <Emphasis text={content.principles.title} />
        </h2>
      </div>
      <ol class="principles__window" role="list">
        {content.principles.items.map((item, index) => (
          <li class="principles__pane" data-reveal style={`--reveal: ${index + 1}`}>
            <span class="principles__number" aria-hidden="true">
              {numerals[index]}
            </span>
            <h3 class="principles__name">{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ol>
      <span class="principles__sill" aria-hidden="true"></span>
    </div>
  </section>

  <section class="path surface-dark" aria-labelledby="path-title">
    <div class="container path__inner">
      <div class="path__head" data-reveal>
        <SectionLabel number="02">{content.path.label}</SectionLabel>
        <h2 id="path-title" class="path__title">
          <Emphasis text={content.path.title} />
        </h2>
        <DemoNote>{content.path.demoNote}</DemoNote>
      </div>
      <ol class="path__list" role="list">
        {content.path.items.map((item, index) => (
          <li class="path__item" data-reveal style={`--reveal: ${Math.min(index, 2)}`}>
            <p class="path__year">{item.year}</p>
            <div class="path__text">
              <h3 class="path__name">{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="space" aria-labelledby="space-title">
    <div class="container space__inner">
      <div class="space__head" data-reveal>
        <SectionLabel number="03">{content.space.label}</SectionLabel>
        <h2 id="space-title" class="space__title">
          <Emphasis text={content.space.title} />
        </h2>
      </div>
      <figure class="space__figure">
        <Window
          class="space__window"
          photo={images.sala}
          locale={locale}
          cols={[30, 40, 30]}
          rows={[30, 70]}
          widths={[640, 960, 1280, 1600, 2000]}
          sizes="(min-width: 90rem) 82rem, 92vw"
          sill
        />
        <figcaption class="space__caption">{content.space.caption}</figcaption>
      </figure>
      <p class="lead space__text" data-reveal>
        {content.space.text}
      </p>
      <div class="space__aside" data-reveal style="--reveal: 1">
        <ul class="space__details" role="list">
          {content.space.details.map((detail) => (
            <li>{detail}</li>
          ))}
        </ul>
        <DemoNote>{content.space.demoNote}</DemoNote>
      </div>
    </div>
  </section>

  <ClosingCta locale={locale} content={content.closing} />
</BaseLayout>

<style>
  /* ---------- Cabeçalho ---------- */

  .about-head__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl);
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .about-head__figure {
    position: relative;
    width: 64%;
  }

  .about-head__figure :global(.about-head__window) {
    aspect-ratio: 3 / 4.6;
  }

  .about-head__caption {
    position: absolute;
    top: calc(100% + var(--bar) * 1.5 + 0.75rem);
    left: 0;
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .about-head__text {
    display: grid;
    justify-items: start;
    gap: var(--space-m);
    margin-top: var(--space-s);
  }

  .about-head__name {
    font-size: var(--step-hero);
    line-height: 0.92;
  }

  .about-head__name span {
    display: block;
  }

  .about-head__surname {
    padding-inline-start: 0.5em;
  }

  .about-head__role {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-style: italic;
    line-height: 1.1;
  }

  /* ---------- História ---------- */

  .story {
    overflow: clip;
  }

  .story__inner {
    display: grid;
    gap: var(--space-xl);
    padding-block: var(--space-2xl) var(--space-section);
  }

  .story__statement {
    max-width: 22ch;
    font-size: clamp(1.875rem, 1.35rem + 2.25vw, 3.375rem);
    line-height: 1.08;
    letter-spacing: var(--tracking-display);
    text-transform: none;
  }

  .story__body {
    position: relative;
    display: grid;
    gap: var(--space-s);
    max-width: 52ch;
    color: var(--fg-muted);
  }

  .story__body p {
    position: relative;
  }

  .story__body :global(.story__light) {
    position: absolute;
    top: -3rem;
    left: 10%;
    width: 80%;
    height: calc(100% + 5rem);
  }

  /* ---------- Princípios: três vidraças de texto ---------- */

  .principles {
    padding-bottom: var(--space-section);
  }

  .principles__head {
    display: grid;
    gap: var(--space-m);
    margin-bottom: var(--space-xl);
  }

  .principles__title {
    font-size: var(--step-5);
    max-width: 14ch;
  }

  .principles__window {
    display: grid;
    gap: var(--bar);
    padding: var(--bar);
    background-color: var(--color-frame);
  }

  .principles__pane {
    display: grid;
    align-content: start;
    gap: var(--space-xs);
    padding: var(--space-l) var(--space-m);
    background-color: var(--color-light);
    box-shadow: var(--shadow-reveal);
  }

  .principles__number {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-style: italic;
    line-height: 1;
    color: var(--color-clay);
  }

  .principles__name {
    font-size: var(--step-3);
    line-height: 1;
    text-transform: uppercase;
  }

  .principles__pane p {
    max-width: 34ch;
    color: var(--color-stone);
  }

  .principles__sill {
    display: block;
    height: calc(var(--bar) * 1.5);
    margin-inline: calc(var(--bar) * -1.75);
    background-color: var(--color-frame);
    box-shadow: var(--shadow-wall);
  }

  /* ---------- Trajetória: o montante como linha do tempo ---------- */

  .path {
    padding-block: var(--space-section);
  }

  .path__inner {
    display: grid;
    gap: var(--space-2xl);
  }

  .path__head {
    display: grid;
    justify-items: start;
    gap: var(--space-m);
  }

  .path__title {
    font-size: var(--step-5);
    max-width: 12ch;
  }

  .path__list {
    position: relative;
    display: grid;
    gap: var(--space-xl);
    padding-inline-start: calc(var(--bar) + var(--space-m));
  }

  /* o montante: uma barra contínua, mais clara que o fundo, como madeira na luz */
  .path__list::before {
    content: '';
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: 0;
    width: var(--bar);
    background-color: var(--color-ink-line);
  }

  /*
   * A luz percorre o montante enquanto a trajetória passa pela tela.
   * Sem suporte a animações ligadas à rolagem, fica só o montante, como antes.
   */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .path__list::after {
        content: '';
        position: absolute;
        top: 0.5rem;
        bottom: 0.5rem;
        left: 0;
        width: var(--bar);
        background-color: color-mix(in srgb, var(--color-light) 30%, var(--color-ink-line));
        transform-origin: top;
        /* longhands: o minificador junta o atalho com a timeline numa declaração inválida */
        animation-name: path-light;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 40% cover 70%;
      }
    }
  }

  @keyframes path-light {
    from {
      scale: 1 0;
    }
  }

  .path__item {
    position: relative;
    /* os marcos ficam por cima da luz que percorre o montante */
    z-index: 1;
    display: grid;
    gap: var(--space-2xs);
  }

  /* cada marco é uma pequena mancha de luz que cruza o montante */
  .path__item::before {
    content: '';
    position: absolute;
    top: 0.55rem;
    left: calc((var(--bar) + var(--space-m)) * -1 - 0.4rem);
    width: calc(var(--bar) + 0.8rem);
    height: 0.75rem;
    background-color: var(--color-light);
    transform: skewX(var(--light-skew));
  }

  .path__year {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1;
    color: var(--accent);
  }

  .path__text {
    display: grid;
    gap: var(--space-2xs);
  }

  .path__name {
    font-family: var(--font-body);
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0;
    text-transform: none;
  }

  .path__text p {
    max-width: 46ch;
    color: var(--fg-muted);
  }

  /* ---------- O espaço ---------- */

  .space__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-l);
    padding-block: var(--space-section) var(--space-xl);
  }

  .space__head {
    display: grid;
    gap: var(--space-m);
  }

  .space__title {
    font-size: var(--step-5);
    max-width: 14ch;
  }

  .space__figure {
    position: relative;
    margin: var(--space-s) 0 var(--space-xl);
  }

  .space__figure :global(.space__window) {
    height: clamp(16rem, 62vw, 40rem);
  }

  .space__caption {
    position: absolute;
    top: calc(100% + var(--bar) * 1.5 + 0.75rem);
    right: 0;
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .space__text {
    max-width: 44ch;
  }

  .space__aside {
    display: grid;
    justify-items: start;
    gap: var(--space-m);
  }

  .space__details {
    display: grid;
    gap: var(--space-xs);
  }

  .space__details li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  /* marcador: uma vidraça em miniatura, como no Hero */
  .space__details li::before {
    content: '';
    flex-shrink: 0;
    width: 0.4375rem;
    height: 0.5625rem;
    border: 1.5px solid var(--color-frame);
  }

  /* ---------- Tablet ---------- */

  @media (min-width: 40rem) {
    .about-head__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: var(--grid-gap);
      align-items: end;
    }

    .about-head__figure {
      width: auto;
    }

    .about-head__text {
      margin: 0 0 var(--space-xl);
    }

    .path__item {
      grid-template-columns: 7rem minmax(0, 1fr);
      gap: var(--space-m);
    }
  }

  /* ---------- Desktop ---------- */

  @media (min-width: 60rem) {
    .about-head__inner {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      padding-block: var(--space-2xl) var(--space-3xl);
    }

    .about-head__figure {
      grid-column: 1 / span 4;
    }

    .about-head__text {
      grid-column: 6 / -1;
    }

    .story__inner {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--grid-gap);
    }

    .story__statement {
      grid-column: 1 / span 6;
      grid-row: 1;
    }

    /* o texto desce até a base da frase, ao lado dela */
    .story__body {
      grid-column: 8 / -1;
      grid-row: 1;
      align-self: end;
    }

    .principles__head {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--grid-gap);
      align-items: end;
    }

    .principles__head > :global(*) {
      grid-column: 1 / span 4;
      align-self: start;
      padding-top: 0.75rem;
    }

    .principles__title {
      grid-column: 5 / -1;
    }

    /* lado a lado só no desktop: no tablet, "CONSENTIMENTO" não cabe em um terço */
    .principles__window {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .principles__pane {
      min-height: 22rem;
    }

    .path__inner {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--grid-gap);
    }

    .path__head {
      grid-column: 1 / span 4;
      align-self: start;
      position: sticky;
      top: calc(var(--header-height) + var(--space-l));
    }

    .path__list {
      grid-column: 6 / -1;
    }

    .path__item {
      grid-template-columns: 9rem minmax(0, 1fr);
    }

    .space__inner {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--grid-gap);
    }

    .space__head,
    .space__figure {
      grid-column: 1 / -1;
    }

    .space__text {
      grid-column: 1 / span 6;
    }

    .space__aside {
      grid-column: 8 / -1;
    }
  }
</style>
